<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:data="using:MyApp.Data" x:Class="MyApp.MainView">
 <UserControl.Styles>
  <Style Selector="TextBox"><Setter Property="MinHeight" Value="40" /></Style>
  <Style Selector="ComboBox"><Setter Property="MinHeight" Value="40" /><Setter Property="HorizontalAlignment" Value="Stretch" /></Style>
  <Style Selector="CalendarDatePicker"><Setter Property="MinHeight" Value="40" /><Setter Property="HorizontalAlignment" Value="Stretch" /></Style>
  <Style Selector="CheckBox"><Setter Property="MinHeight" Value="40" /></Style>
  <Style Selector="Button"><Setter Property="MinHeight" Value="40" /><Setter Property="HorizontalAlignment" Value="Stretch" /></Style>
  <Style Selector="TextBlock"><Setter Property="TextWrapping" Value="Wrap" /></Style>
  <Style Selector="ListBoxItem"><Setter Property="HorizontalContentAlignment" Value="Stretch" /></Style>
 </UserControl.Styles>
 <Grid Margin="12" RowDefinitions="Auto,*">
  <TextBlock Text="FixPoint · ремонт техники" FontSize="21" FontWeight="Bold" Margin="0,0,0,10" />
  <TabControl x:Name="Tabs" Grid.Row="1">
<TabItem Header="Клиенты"><ScrollViewer HorizontalScrollBarVisibility="Disabled"><StackPanel Spacing="8" Margin="4,10,4,12">
 <TextBlock Text="Клиенты" FontSize="18" FontWeight="Bold" />
 <ListBox x:Name="ClientsList" MaxHeight="210" MinHeight="100" SelectionChanged="ClientsSelected">
  <ListBox.ItemTemplate><DataTemplate x:DataType="data:Client"><StackPanel Spacing="3" Margin="4">
<TextBlock Text="{Binding FullName}" FontWeight="Bold" /><TextBlock Text="{Binding Phone}" /><TextBlock Text="{Binding Email}" />
</StackPanel></DataTemplate></ListBox.ItemTemplate></ListBox>
<TextBlock x:Name="ClientsMessage" Foreground="#923000" FontWeight="SemiBold" />
<TextBlock Text="ФИО" />
<TextBox x:Name="ClientFullName" />
<TextBlock Text="Телефон" />
<TextBox x:Name="ClientPhone" />
<TextBlock Text="Электронная почта (необязательно)" />
<TextBox x:Name="ClientEmail" />
<TextBlock Text="VIP-клиент" />
<CheckBox x:Name="ClientIsVip" Content="Да" />
<Button x:Name="ClientsAddButton" Content="Добавить" Click="ClientsAdd" />
<Button x:Name="ClientsSaveButton" Content="Сохранить" Click="ClientsSave" />
<Button x:Name="ClientsDeleteButton" Content="Удалить" Click="ClientsDelete" />
<Button x:Name="ClientsClearButton" Content="Очистить поля" Click="ClientsClear" />
<TextBlock Text="Заявки выбранного клиента" FontWeight="Bold" />
  <ListBox x:Name="ClientRequestsList" MaxHeight="180"><ListBox.ItemTemplate><DataTemplate x:DataType="data:RepairRequest"><StackPanel Margin="4"><TextBlock Text="{Binding Service.Name}" /><TextBlock Text="{Binding ProblemDescription}" /></StackPanel></DataTemplate></ListBox.ItemTemplate></ListBox>
</StackPanel></ScrollViewer></TabItem>
<TabItem Header="Услуги"><ScrollViewer HorizontalScrollBarVisibility="Disabled"><StackPanel Spacing="8" Margin="4,10,4,12">
 <TextBlock Text="Услуги" FontSize="18" FontWeight="Bold" />
 <ListBox x:Name="ServicesList" MaxHeight="210" MinHeight="100" SelectionChanged="ServicesSelected">
  <ListBox.ItemTemplate><DataTemplate x:DataType="data:Service"><StackPanel Spacing="3" Margin="4">
<TextBlock Text="{Binding Name}" FontWeight="Bold" /><TextBlock Text="{Binding Price, StringFormat='Цена: {0} руб.'}" /><TextBlock Text="{Binding DurationMinutes, StringFormat='Длительность: {0} мин.'}" /><TextBlock Text="{Binding IsAvailable, StringFormat='Доступна: {0}'}" />
</StackPanel></DataTemplate></ListBox.ItemTemplate></ListBox>
<TextBlock x:Name="ServicesMessage" Foreground="#923000" FontWeight="SemiBold" />
<TextBlock Text="Название услуги" />
<TextBox x:Name="ServiceName" />
<TextBlock Text="Цена, руб." />
<TextBox x:Name="ServicePrice" />
<TextBlock Text="Длительность, мин." />
<TextBox x:Name="ServiceDurationMinutes" />
<TextBlock Text="Услуга доступна" />
<CheckBox x:Name="ServiceIsAvailable" Content="Да" />
<Button x:Name="ServicesAddButton" Content="Добавить" Click="ServicesAdd" />
<Button x:Name="ServicesSaveButton" Content="Сохранить" Click="ServicesSave" />
<Button x:Name="ServicesDeleteButton" Content="Удалить" Click="ServicesDelete" />
<Button x:Name="ServicesClearButton" Content="Очистить поля" Click="ServicesClear" />
</StackPanel></ScrollViewer></TabItem>
<TabItem Header="Заявки"><ScrollViewer HorizontalScrollBarVisibility="Disabled"><StackPanel Spacing="8" Margin="4,10,4,12">
 <TextBlock Text="Заявки" FontSize="18" FontWeight="Bold" />
 <ListBox x:Name="RequestsList" MaxHeight="210" MinHeight="100" SelectionChanged="RequestsSelected">
  <ListBox.ItemTemplate><DataTemplate x:DataType="data:RepairRequest"><StackPanel Spacing="3" Margin="4">
<TextBlock Text="{Binding Client.FullName}" FontWeight="Bold" /><TextBlock Text="{Binding Service.Name}" /><TextBlock Text="{Binding ProblemDescription}" /><TextBlock Text="{Binding StatusCode, StringFormat='Статус: {0}'}" /><TextBlock Text="{Binding CreatedAt, StringFormat='Дата: {0:dd.MM.yyyy}'}" />
</StackPanel></DataTemplate></ListBox.ItemTemplate></ListBox>
<TextBlock x:Name="RequestsMessage" Foreground="#923000" FontWeight="SemiBold" />
<TextBlock Text="Клиент" />
<ComboBox x:Name="RepairRequestClient"><ComboBox.ItemTemplate><DataTemplate x:DataType="data:Client"><TextBlock Text="{Binding FullName}" /></DataTemplate></ComboBox.ItemTemplate></ComboBox>
<TextBlock Text="Услуга" />
<ComboBox x:Name="RepairRequestService"><ComboBox.ItemTemplate><DataTemplate x:DataType="data:Service"><TextBlock Text="{Binding Name}" /></DataTemplate></ComboBox.ItemTemplate></ComboBox>
<TextBlock Text="Дата заявки" />
<CalendarDatePicker x:Name="RepairRequestCreatedAt" />
<TextBlock Text="Описание проблемы" />
<TextBox x:Name="RepairRequestProblemDescription" />
<TextBlock Text="Статус: 1 — новая, 2 — в работе, 3 — готова" />
<TextBox x:Name="RepairRequestStatusCode" />
<Button x:Name="RequestsAddButton" Content="Добавить" Click="RequestsAdd" />
<Button x:Name="RequestsSaveButton" Content="Сохранить" Click="RequestsSave" />
<Button x:Name="RequestsDeleteButton" Content="Удалить" Click="RequestsDelete" />
<Button x:Name="RequestsClearButton" Content="Очистить поля" Click="RequestsClear" />
</StackPanel></ScrollViewer></TabItem>
</TabControl></Grid></UserControl>